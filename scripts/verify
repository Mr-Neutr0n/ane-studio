#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "==> TypeScript"
bun run typecheck

echo "==> Format and lint"
bun run check

echo "==> Renderer tests"
bun run test

echo "==> Release tooling tests"
bun test scripts/release-tooling.test.ts

echo "==> Worker checks"
uv run --project worker --extra coreml --extra test --locked ruff format --check worker scripts/bundle-runtime.py scripts/profile-model.py scripts/summarize-profile.py
uv run --project worker --extra coreml --extra test --locked ruff check worker scripts/bundle-runtime.py scripts/profile-model.py scripts/summarize-profile.py
uv run --project worker --extra coreml --extra test --locked pytest -c worker/pyproject.toml worker/tests

echo "==> Production build"
bun run build

echo "==> Electron startup"
bunx playwright test

echo "==> Public website"
(cd website && bun run verify)

echo "==> Repository checks"
bun scripts/check-repository.ts
git diff --check

echo "verify passed"
