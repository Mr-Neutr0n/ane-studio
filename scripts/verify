#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "==> TypeScript"
bun run typecheck

echo "==> Format and lint"
bun run check

echo "==> Renderer tests"
bun run test

echo "==> Worker checks"
uv run --project worker --extra coreml --extra test --locked ruff format --check worker
uv run --project worker --extra coreml --extra test --locked ruff check worker
uv run --project worker --extra coreml --extra test --locked pytest

echo "==> Production build"
bun run build

echo "==> Electron startup"
bunx playwright test

echo "==> Repository checks"
git diff --check
if rg -n --hidden --glob '!bun.lock' --glob '!worker/uv.lock' --glob '!licenses/**' 'hf_[A-Za-z0-9]{20,}' .; then
  echo "error: possible Hugging Face token in repository" >&2
  exit 1
fi

echo "verify passed"
