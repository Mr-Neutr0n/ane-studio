{
  "name": "ane-studio",
  "version": "0.1.0",
  "description": "A local lab for converting, testing, and chatting with small Hugging Face language models on Apple Silicon.",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Hari Krishna",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "bun run runtime:prepare && bun run runtime:check && bun run build && electron-builder --mac dir --arm64 --publish never",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "worker:setup": "uv sync --project worker --extra coreml --locked",
    "worker:test": "uv run --project worker --extra coreml --extra test --locked pytest -c worker/pyproject.toml worker/tests",
    "verify": "./scripts/verify",
    "runtime:prepare": "bun scripts/prepare-runtime.ts",
    "runtime:check": "bun scripts/check-runtime.ts",
    "package:test": "bun scripts/test-package.ts",
    "release:local": "bun run package && bun run package:test && bun scripts/archive-release.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.harikrishna.anestudio",
    "productName": "ANE Studio",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources/icons"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "worker",
        "to": "worker",
        "filter": [
          "pyproject.toml",
          "uv.lock",
          "src/**/*"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "artifacts/runtime",
        "to": "runtime"
      },
      {
        "from": "artifacts/runtime-notices",
        "to": "licenses/runtime"
      },
      {
        "from": "LICENSE",
        "to": "licenses/ANE-STUDIO-LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "MODEL_LICENSES.md",
        "to": "licenses/MODEL_LICENSES.md"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "artifactName": "ANE-Studio-${version}-${arch}.${ext}",
      "identity": null,
      "minimumSystemVersion": "15.0",
      "icon": "resources/icons/icon.icns"
    }
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/Mr-Neutr0n/ane-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-Neutr0n/ane-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Mr-Neutr0n/ane-studio/issues"
  }
}
